// Configure the Jenkins job's Script Path as smart-expense/Jenkinsfile.
// Actual deployment and service credentials require the repository owner's environment.
pipeline {
  agent any
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Validate') {
      steps {
        dir('smart-expense') {
          sh '''python3 -m venv .venv
. .venv/bin/activate
pip install -r requirements-dev.txt
export DB_ENGINE=sqlite
ruff check .
python manage.py check
python manage.py makemigrations --check --dry-run
pytest --cov-fail-under=70
'''
        }
      }
    }
    stage('Build') { steps { dir('smart-expense') { sh 'docker compose build web' } } }
    stage('Owner approved deployment') {
      input { message 'Deploy validated build to the configured academic demonstration host?' }
      steps { dir('smart-expense') { sh 'docker compose up -d --build' } }
    }
  }
}
