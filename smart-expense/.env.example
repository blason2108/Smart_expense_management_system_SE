# Copy to .env (never commit .env)
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Database (postgres | sqlite). sqlite is for quick local runs only.
DB_ENGINE=postgres
DB_NAME=smart_expense
DB_USER=smart_expense
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# HTTPS (SEB-SR-001) - set true in production-like environments
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# Alerts (SEB-F-010) - console backend = sandbox
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=alerts@smartexpense.local
BUDGET_ALERT_DEFAULT_THRESHOLD_PERCENT=80
